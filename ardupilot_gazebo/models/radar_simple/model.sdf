<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='radar_simple'>
    <static>true</static>
    <link name='link'>
      <pose>0 0 0 0 0 0</pose>
      <!-- Base platform -->
      <visual name='platform'>
        <geometry>
          <box>
            <size>2 2 0.4</size>
          </box>
        </geometry>
        <material>
          <!-- dark metallic base -->
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.20 1</diffuse>
          <specular>0.3 0.3 0.32 1</specular>
        </material>
      </visual>

      <!-- Radar dish -->
      <visual name='dish'>
        <pose>0 0 0.55 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.7</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <!-- metallic dish (light grey) -->
          <ambient>0.6 0.6 0.62 1</ambient>
          <diffuse>0.78 0.78 0.80 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>

      <!-- Radar mast -->
      <visual name='mast'>
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
        <material>
          <!-- mast color darker grey -->
          <ambient>0.25 0.25 0.26 1</ambient>
          <diffuse>0.3 0.3 0.32 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>
