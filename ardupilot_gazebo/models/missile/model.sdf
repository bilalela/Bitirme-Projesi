<?xml version="1.0"?>
<sdf version="1.9">
  <model name="missile">
    <static>false</static>
    <link name="body">
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      
      <collision name="missile_collision">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
      </collision>
      
      <visual name="missile_visual">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.0 1</ambient>
          <diffuse>0.5 0.5 0.0 1</diffuse>
          <specular>0.6 0.6 0.2 1</specular>
        </material>
      </visual>
      
      <!-- Flame/exhaust visual at tail -->
      <visual name="exhaust_visual">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.5 0.0 0.8</ambient>
          <diffuse>1.0 0.6 0.0 0.8</diffuse>
          <specular>0.8 0.4 0.0 0.8</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
