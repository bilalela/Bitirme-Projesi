<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='sam_launcher'>
    <static>true</static>
    <link name='base'>
      <pose>0 0 0 0 0 0</pose>
      <!-- Base -->
      <visual name='base_box'>
        <geometry>
          <box>
            <size>1.5 0.8 0.4</size>
          </box>
        </geometry>
        <material>
          <!-- base dark grey -->
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <!-- Launcher rail assembly: three missiles side-by-side -->
      <visual name='missile_1'>
        <pose>0.0 -0.25 0.35 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>1.2</length>
          </cylinder>
        </geometry>
        <material>
          <!-- missile olive/green -->
          <ambient>0.12 0.18 0.08 1</ambient>
          <diffuse>0.18 0.28 0.12 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name='missile_2'>
        <pose>0.0 0.0 0.35 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>1.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.18 0.08 1</ambient>
          <diffuse>0.18 0.28 0.12 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name='missile_3'>
        <pose>0.0 0.25 0.35 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>1.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.18 0.08 1</ambient>
          <diffuse>0.18 0.28 0.12 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

    </link>
  </model>
</sdf>
